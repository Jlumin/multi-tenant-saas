datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  isActive  Boolean  @default(true) @map("is_active")
  memberships Membership[]
  invitations Invitation[]
  auditEvents TenantAudit[]
  projects Project[]
  wmsProducts WmsProduct[]
  wmsWarehouses WmsWarehouse[]

  @@map("tenants")
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}


model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  auditEvents   TenantAudit[]

  @@map("auth_users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

enum MembershipRole {
  owner
  member
}

model Membership {
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role MembershipRole @default(member)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitations Invitation[]
  projects Project[]

  @@id([tenantId, userId])
  @@index([userId, isActive])
  @@map("memberships")
}

model Project {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(2000)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version Int @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator Membership @relation(fields: [tenantId, createdBy], references: [tenantId, userId], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, deletedAt, createdAt, id])
  @@map("projects")
}

model Invitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  email String
  role MembershipRole @default(member)
  tokenHash String @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator Membership @relation(fields: [tenantId, createdById], references: [tenantId, userId], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("invitations")
}

model TenantAudit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String @db.VarChar(60)
  targetId String @map("target_id") @db.Uuid
  requestId String? @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("tenant_audit")
}

model WmsProduct {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code String @map("sku") @db.VarChar(40)
  name String @db.VarChar(120)
  baseUnit String @map("base_unit") @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  units WmsProductUnit[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, id])
  @@map("wms_products")
}

model WmsProductUnit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  code String @db.VarChar(40)
  name String @db.VarChar(120)
  factor Int
  isBase Boolean @default(false) @map("is_base")
  isActive Boolean @default(true) @map("is_active")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  product WmsProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, productId, id])
  @@unique([tenantId, productId, code])
  @@index([tenantId, productId, isActive, id])
  @@map("wms_product_units")
}

model WmsWarehouse {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code String @db.VarChar(40)
  name String @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locations WmsLocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, id])
  @@map("wms_warehouses")
}

model WmsLocation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  code String @db.VarChar(40)
  name String @db.VarChar(120)
  isDefault Boolean @default(false) @map("is_default")
  isActive Boolean @default(true) @map("is_active")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  warehouse WmsWarehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, id])
  @@unique([tenantId, warehouseId, code])
  @@index([tenantId, warehouseId, isActive, id])
  @@map("wms_locations")
}
