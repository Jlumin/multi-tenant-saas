# Disposable local development examples only; never use these values in production.
POSTGRES_DB=multi_tenant_dev
POSTGRES_USER=bootstrap_dev
POSTGRES_PASSWORD=local-example-not-a-secret
POSTGRES_PORT=55432
DATABASE_URL=postgresql://bootstrap_dev:local-example-not-a-secret@127.0.0.1:55432/multi_tenant_dev
# Used ONLY by db:smoke to create/drop its own randomly named test database.
TEST_DATABASE_ADMIN_URL=postgresql://bootstrap_dev:local-example-not-a-secret@127.0.0.1:55432/postgres
# Generate a private random secret locally; leave no real value in this example.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
